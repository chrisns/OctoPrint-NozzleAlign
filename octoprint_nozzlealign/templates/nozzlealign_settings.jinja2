<form class="form-horizontal">
  <h4>Camera</h4>
  <div class="control-group">
    <label class="control-label">Snapshot URL</label>
    <div class="controls">
      <input type="text" class="input-xxlarge"
             data-bind="value: settings.plugins.nozzlealign.snapshot_url">
      <span class="help-block">
        A single JPEG frame. OctoPrint fetches this, so 127.0.0.1 is correct.
      </span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Frames to average</label>
    <div class="controls">
      <input type="number" class="input-mini"
             data-bind="value: settings.plugins.nozzlealign.frame_average">
    </div>
  </div>

  <h4>Camera position on the bed</h4>
  <div class="alert">
    Use "Find the camera" on the Nozzle Align tab. It fills these in for you.
    Only edit them by hand if the search fails.
  </div>
  <div class="control-group">
    <label class="control-label">X, Y, Z</label>
    <div class="controls">
      <input type="number" step="0.01" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.camera_x">
      <input type="number" step="0.01" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.camera_y">
      <input type="number" step="0.01" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.camera_z">
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Safe Z</label>
    <div class="controls">
      <input type="number" step="0.1" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.safe_z">
      <span class="help-block">Every travel move goes through this height.</span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Home first</label>
    <div class="controls">
      <input type="checkbox"
             data-bind="checked: settings.plugins.nozzlealign.home_first">
    </div>
  </div>

  <h4>Finding the camera</h4>
  <div class="control-group">
    <label class="control-label">Search height</label>
    <div class="controls">
      <input type="number" step="1" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.search_z">
      <span class="help-block">
        The height the search starts from. It must clear everything on the bed.
      </span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Search centre and span</label>
    <div class="controls">
      <input type="number" step="1" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.search_centre_x">
      <input type="number" step="1" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.search_centre_y">
      <input type="number" step="1" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.search_span_mm">
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Lowest allowed Z</label>
    <div class="controls">
      <input type="number" step="1" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.min_z">
      <span class="help-block">
        A hard floor. The search also measures where the lens is and stops above
        it, so it normally stops before this.
      </span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Clearance above the lens</label>
    <div class="controls">
      <input type="number" step="0.5" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.lens_clearance_mm">
    </div>
  </div>

  <h4>Closed loop</h4>
  <div class="control-group">
    <label class="control-label">Probe distance (mm)</label>
    <div class="controls">
      <input type="number" step="0.1" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.probe_distance">
      <span class="help-block">
        The known move used to measure the pixel scale and the camera rotation.
      </span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Tolerance (mm)</label>
    <div class="controls">
      <input type="number" step="0.001" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.tolerance_mm">
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Maximum passes</label>
    <div class="controls">
      <input type="number" class="input-mini"
             data-bind="value: settings.plugins.nozzlealign.max_passes">
    </div>
  </div>

  <h4>Detection</h4>
  <div class="control-group">
    <label class="control-label">Strategy</label>
    <div class="controls">
      <select data-bind="value: settings.plugins.nozzlealign.strategy">
        <option value="motion">motion</option>
        <option value="contour">contour</option>
        <option value="hough">hough</option>
        <option value="template">template</option>
      </select>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Motion probe (mm)</label>
    <div class="controls">
      <input type="number" step="0.1" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.motion_probe_mm">
      <span class="help-block">
        The motion strategy finds the nozzle by nudging it and watching which
        pixels change. It needs no appearance settings at all.
      </span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Dark nozzle</label>
    <div class="controls">
      <input type="checkbox"
             data-bind="checked: settings.plugins.nozzlealign.contour_invert">
      <span class="help-block">
        Tick when the nozzle is darker than its background.
      </span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Blur, minimum area</label>
    <div class="controls">
      <input type="number" class="input-mini"
             data-bind="value: settings.plugins.nozzlealign.blur">
      <input type="number" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.min_area">
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Hough radius, param2</label>
    <div class="controls">
      <input type="number" class="input-mini"
             data-bind="value: settings.plugins.nozzlealign.min_radius">
      <input type="number" class="input-mini"
             data-bind="value: settings.plugins.nozzlealign.max_radius">
      <input type="number" class="input-mini"
             data-bind="value: settings.plugins.nozzlealign.hough_param2">
    </div>
  </div>

  <h4>Firmware guard</h4>
  <div class="control-group">
    <label class="control-label">Expected offset X, Y</label>
    <div class="controls">
      <input type="number" step="0.01" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.nominal_offset_x">
      <input type="number" step="0.01" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.nominal_offset_y">
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Allowed deviation (mm)</label>
    <div class="controls">
      <input type="number" step="0.1" class="input-small"
             data-bind="value: settings.plugins.nozzlealign.offset_limit_mm">
      <span class="help-block">
        The plugin refuses to write an offset further than this from the
        expected value.
      </span>
    </div>
  </div>
  <div class="control-group">
    <label class="control-label">Also send M500</label>
    <div class="controls">
      <input type="checkbox"
             data-bind="checked: settings.plugins.nozzlealign.save_to_eeprom">
    </div>
  </div>
</form>
