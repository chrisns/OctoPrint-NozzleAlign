<div id="nozzlealign_tab">
  <div class="row-fluid">
    <div class="span7">
      <div class="nozzlealign-view">
        <img data-bind="attr: {src: overlayUrl}" class="nozzlealign-frame">
      </div>
      <p class="muted">
        The blue crosshair is the target. The red circle is the nozzle bore
        that the run will steer on. Yellow means the score is too low to use.
      </p>
      <div class="btn-group">
        <button class="btn" data-bind="click: refreshPreview">Refresh</button>
        <button class="btn" data-bind="click: toggleLive,
                css: {'btn-primary': live}">Live</button>
      </div>
    </div>

    <div class="span5">
      <h4>Calibrate</h4>
      <p class="muted">
        Put the camera anywhere on the bed, lens up. The run homes, looks
        for the nozzle where the camera was last time, and if it is not
        there sweeps the whole bed at Z90 to find it. It then sweeps Z for
        the sharpest picture, steers each nozzle onto the same pixel and
        reports the offset that puts both nozzles on one spot. It checks
        that the nozzle it measures is the active one.
      </p>
      <p data-bind="text: cameraText, visible: cameraText" class="text-success"></p>
      <div class="btn-group">
        <button class="btn btn-primary" data-bind="click: run,
                enable: !running()">Calibrate</button>
        <button class="btn btn-danger" data-bind="click: abort,
                enable: running">Stop</button>
      </div>

      <h5>Progress</h5>
      <pre class="nozzlealign-log" data-bind="text: log"></pre>

      <!-- ko if: result -->
      <h5>Result</h5>
      <table class="table table-condensed">
        <tr><th>Stored T1 offset</th>
            <td data-bind="text: storedOffsetText"></td></tr>
        <tr><th>Nozzle 1 landed</th>
            <td data-bind="text: correctionText"></td></tr>
        <tr><th>Offset that fixes it</th>
            <td data-bind="text: newOffsetText"></td></tr>
        <tr><th>Residual after centring</th>
            <td data-bind="text: residualText"></td></tr>
        <tr><th>Image scale</th>
            <td data-bind="text: scaleText"></td></tr>
        <tr><th>Camera</th>
            <td data-bind="text: cameraText"></td></tr>
      </table>

      <p>
        Write the offset, then calibrate again. The second run must report
        nozzle 1 landing within a few microns of nozzle 0.
      </p>
      <div class="btn-group">
        <button class="btn btn-primary" data-bind="click: applyNew, text: applyLabel"></button>
      </div>
      <p class="muted">
        Prefer the slicer instead? Put the numbers above into the tool offset
        there and write nothing to the firmware.
      </p>
      <!-- /ko -->
    </div>
  </div>
</div>
